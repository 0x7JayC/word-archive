{
  "name": "word-archive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/flows.mjs && node tests/e2e/transcribe.mjs && node tests/e2e/roadmap3d.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run test:e2e",
    "deploy:preview": "npx --yes vercel@latest deploy",
    "deploy": "npx --yes vercel@latest deploy --prod"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "fflate": "^0.8.3",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "0.128.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.3.7",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^24.1.3",
    "typescript": "5.9.3",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "std-env": "4.2.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
